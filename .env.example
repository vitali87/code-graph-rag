# Model Provider Configuration

# Example 1: All Ollama (local)
# ORCHESTRATOR_PROVIDER=ollama
# ORCHESTRATOR_MODEL=qwen2.5-coder
# ORCHESTRATOR_ENDPOINT=http://localhost:11434/v1

# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=qwen2.5-coder
# CYPHER_ENDPOINT=http://localhost:11434/v1

# Example 2: All OpenAI
# ORCHESTRATOR_PROVIDER=openai
# ORCHESTRATOR_MODEL=gpt-5.6-terra
# ORCHESTRATOR_API_KEY=sk-your-openai-key

# CYPHER_PROVIDER=openai
# CYPHER_MODEL=gpt-5.6-luna
# CYPHER_API_KEY=sk-your-openai-key

# Example 3: All Google (AI Studio)
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-3.6-flash
# ORCHESTRATOR_API_KEY=your-google-api-key

# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-3.5-flash-lite
# CYPHER_API_KEY=your-google-api-key

# Example 4: Google Vertex AI
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-3.6-flash
# ORCHESTRATOR_PROJECT_ID=your-gcp-project-id
# ORCHESTRATOR_REGION=us-central1
# ORCHESTRATOR_PROVIDER_TYPE=vertex
# ORCHESTRATOR_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-3.5-flash-lite
# CYPHER_PROJECT_ID=your-gcp-project-id
# CYPHER_REGION=us-central1
# CYPHER_PROVIDER_TYPE=vertex
# CYPHER_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# Example 5: Mixed - Google orchestrator + Ollama cypher
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-3.6-flash
# ORCHESTRATOR_API_KEY=your-google-api-key

# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=qwen2.5-coder
# CYPHER_ENDPOINT=http://localhost:11434/v1

# Example 6: Mixed - OpenAI orchestrator + Google cypher
# ORCHESTRATOR_PROVIDER=openai
# ORCHESTRATOR_MODEL=gpt-5.6-terra
# ORCHESTRATOR_API_KEY=sk-your-openai-key

# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-3.5-flash-lite
# CYPHER_API_KEY=your-google-api-key

# Example 6: LiteLLM with custom provider
# ORCHESTRATOR_PROVIDER=litellm_proxy
# ORCHESTRATOR_MODEL=gpt-oss:120b
# ORCHESTRATOR_ENDPOINT=http://litellm:4000/v1
# ORCHESTRATOR_API_KEY=sk-your-litellm-key

# CYPHER_PROVIDER=litellm_proxy
# CYPHER_MODEL=openrouter/gpt-oss:120b
# CYPHER_ENDPOINT=http://litellm:4000/v1
# CYPHER_API_KEY=sk-your-litellm-key

# Thinking budget for reasoning models (optional)
# ORCHESTRATOR_THINKING_BUDGET=10000
# CYPHER_THINKING_BUDGET=5000

# Graph engine: sqlite (default: an embedded graph in one file, no server),
# memgraph or neo4j. Memgraph and Neo4j each need their optional driver:
# uv pip install 'code-graph-rag[memgraph]' or 'code-graph-rag[neo4j]'
GRAPH_BACKEND=sqlite
# The embedded graph's file; unset means ~/.cgr/graph.sqlite.
# SQLITE_GRAPH_PATH=~/.cgr/graph.sqlite
# Rows per write batch, for every engine (the name predates the others).
MEMGRAPH_BATCH_SIZE=1000

# Memgraph settings (only read when GRAPH_BACKEND=memgraph)
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_HTTP_PORT=7444
# Memgraph authentication credentials
# Leave both empty if your Memgraph instance doesn't require authentication.
# If authentication is enabled, provide both username and password.
# With both set, `cgr daemon up` also creates this user in the bundled Memgraph,
# which turns authentication on (see docs/architecture/security.md).
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
LAB_PORT=3000

# Only used when GRAPH_BACKEND=neo4j. Leave the credentials empty for an
# unauthenticated server.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Qdrant settings, read only with CGR_VECTOR_STORE_BACKEND=qdrant below
# With QDRANT_URL and QDRANT_DB_PATH both unset, embeddings go to the Qdrant
# `cgr daemon up` runs when Docker Compose reports that stack's Qdrant
# container running, and to local file mode in ./.qdrant_code_embeddings
# otherwise (only suitable below ~20k embeddings). Set QDRANT_DB_PATH, even to
# that default, to always use local file mode in that folder, or point
# QDRANT_URL at any Qdrant server:
# QDRANT_URL=http://localhost:6333
# API key for a Qdrant server that requires one: always Qdrant Cloud, and a
# self-hosted server started with QDRANT__SERVICE__API_KEY. Ignored in local
# file mode. The key is sent as a request header, so it is refused over a plain
# http:// QDRANT_URL; set QDRANT_ALLOW_INSECURE_API_KEY=true only when that
# connection is protected another way (e.g. it never leaves the machine).
# With QDRANT_API_KEY set and QDRANT_URL pointing at the bundled Qdrant (the
# address and port Compose publishes it on), `cgr daemon up` also starts it
# with the key. That stack serves plain http on 127.0.0.1, so it needs the
# opt-in above. A key for another server, such as Qdrant Cloud or another
# Qdrant on this machine, is never copied into the local container.
# QDRANT_API_KEY=
# QDRANT_ALLOW_INSECURE_API_KEY=false

# Semantic vector store backend
# sqlite is the default: a file beside the embedded graph, with no server
# (sqlite-vec, in the `semantic` extra); SQLITE_VECTOR_PATH moves it. Set qdrant
# to use the Qdrant settings above. Set Milvus to use Milvus Lite or a
# self-hosted endpoint.
# CGR_VECTOR_STORE_BACKEND=sqlite
# SQLITE_VECTOR_PATH=~/.cgr/vectors.sqlite
# CGR_VECTOR_STORE_BACKEND=qdrant
# CGR_VECTOR_STORE_BACKEND=milvus
# MILVUS_URI=./.milvus_code_embeddings.db
# MILVUS_URI=http://localhost:19530

# Repository settings
TARGET_REPO_PATH=.

# Capture groups: what an index writes to the graph. Unset, only the default
# groups. Tokens are separated by commas, semicolons or spaces: a group or a
# relationship type adds (io, +HAS_PARAMETER), -NAME drops (-calls), and all or
# none replaces the selection. `--capture` on cgr start / cgr index applies
# after it. The groups, their defaults and what each adds:
# docs/architecture/graph-schema.md#capture-groups
# CGR_CAPTURE=io

# Ollama base URL (without /v1 suffix)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# 本地部署段落（Windows 单机 / 中文代码库）
# 这一段由 bootstrap.ps1 生成对应 .env 时使用；手工部署可参考。
# 所有路径都是绝对路径 —— cgr 只做 expanduser()，不解析相对路径。
# ============================================================================

# 数据根目录：图谱、向量库、embedding 缓存、模型、同步状态都在这里
# CGR_HOME=F:/<你的路径>/cgr-data

# 图谱与向量库（不设则落在 CGR_HOME 下）
# SQLITE_GRAPH_PATH=F:/<你的路径>/cgr-data/db/mes-graph.sqlite
# SQLITE_VECTOR_PATH=F:/<你的路径>/cgr-data/db/mes-vectors.sqlite

# 本地 embedding 模型目录（bge-m3），必须与 SQLITE_VECTOR_DIM 匹配。
# bge-m3 = XLM-RoBERTa 编码器，原生支持中文 + 英文 + 代码检索。
# 注意：CGR_EMBEDDING_PROVIDER 的取值 "unixcoder" 是历史命名，
#       实际加载的是 bge-m3（见 codebase_rag/constants/providers.py:92）。
# CGR_EMBEDDING_PROVIDER=unixcoder
# CGR_EMBEDDING_MODEL=F:/<你的路径>/cgr-data/models/bge-m3
# SQLITE_VECTOR_DIM=1024
# 设备留空 = 自动探测 CUDA -> MPS -> CPU；也可强制 cuda / mps / cpu
# CGR_EMBEDDING_DEVICE=
# 批大小：CPU 建议 64，GPU 16GB 可到 256（显存不足会自动减半重试）
# CGR_EMBEDDING_BATCH_SIZE=64
# CGR_EMBEDDING_MAX_LENGTH=1024

# HuggingFace 离线运行（模型已本地化后开启，避免启动时联网）
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1
# HF_HUB_CACHE=F:/<你的路径>/cgr-data/hf-cache
