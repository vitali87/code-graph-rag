# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Local secrets (.env.local, .env.production, ...); .env.example is the
# committed template
.env
.env.*
!.env.example
.tmp
.ruff_cache/
.mypy_cache/
.pytest_cache/
.claude/
.qdrant_code_embeddings/
PROJECT.md
.coverage
.envrc
.DS_Store
.pypi_cache.json
.omc
site/
# Written by the docs workflow before each build; never committed (#2175)
docs/credits.md

# Eval harness scratch workspace (regenerated each run); result files are committed
evals/results/l3_workspace/
# Rust oracle build artifacts (the source + Cargo.lock are committed)
evals/oracles/rs_oracle/target/
evals/oracles/rs_oracle/.build.lock
# TypeScript oracle deps (the source + package-lock.json are committed)
evals/oracles/ts_oracle/node_modules/
# Java oracle compiled classes (the source is committed)
evals/oracles/java_oracle/*.class
evals/oracles/java_oracle/.build-lock
# Lua oracle deps (the source + package-lock.json are committed)
evals/oracles/lua_oracle/node_modules/
# PHP oracle deps (the source + package-lock.json are committed)
evals/oracles/php_oracle/node_modules/
# Ruby oracle deps (the source + package-lock.json are committed)
evals/oracles/ruby_oracle/node_modules/
# Node oracle install bookkeeping (completion marker + concurrent-install lock)
evals/oracles/*/.node-deps-installed
evals/oracles/*/.node-deps-lock/
# Scala oracle build artifacts (the source is committed; scala-cli fetches deps)
evals/oracles/scala_oracle/.scala-build/
evals/oracles/scala_oracle/.bsp/
.cgr-hash-cache.json
.cgr-dir-mtimes.json
.cgr-parser-fingerprint
.cgr-exclusion-state.json
.cgr-delombok-state.json
.cgr-edit-history.json
.cgr-edit-lock
.cgr-sync-lock

# Runtime call traces (pytest --cgr-trace default output)
cgr-trace.jsonl

# ---------------------------------------------------------------------------
# Local deployment state (this fork's Windows setup). None of this belongs in
# git: it is machine-specific, multi-GB, or regenerated by the scripts.
# ---------------------------------------------------------------------------

# Data root: graph db, vector db, embedding cache, bge-m3 model, sync state.
# ~2.5 GB. Recreate with `.\start_cgr_env.ps1 -Install` + a model fetch, or
# point CGR_HOME elsewhere. Must come BEFORE the `cgr*` package globs below.
/cgr-data/

# Repo alias table (absolute paths) and the MCP server registry (PIDs/ports).
repos.json
cgr-data/mcp/servers.json

# Rust build artifacts (source + Cargo.lock are tracked)
rust/cgr_graph_rs/target/

# Torch CUDA wheel staged at the repo root by scripts/install_cuda_torch.ps1
torch-*.whl

# MCP client config written by setup_mcp.ps1 (contains absolute paths)
mcp.json

# Indexing-benchmark corpus checkouts (pinned clones, see evals/indexing_bench.py)
evals/results/corpora/
evals/results/**/agentic_qa*records*.jsonl
evals/results/logs/
.cgr-parser-fingerprint
.cgr-exclusion-state.json
.cgr-*.tmp
