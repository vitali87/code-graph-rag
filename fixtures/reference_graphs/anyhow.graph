N	Method	"anyhow.src.error.Error.from_boxed"	{"absolute_path":"<root>/src/error.rs","anchor_hash":"ah1:e6b02736333555079b97849a1f66456e510e4ae95a7698dec20ffee70cdc04e0","ast_branch_fingerprints":["2f29090d88681c14","f463b4e4264d6b2d"],"ast_fingerprint":"7d6c68bf1a50e6e9","ast_fingerprint_nodes":17,"decorated_start_line":141,"decorators":[],"docstring":"Construct an error object from a type-erased standard library error.\n\nThis is mostly useful for interop with other error libraries.\n\n# Example\n\nHere is a skeleton of a library that provides its own error abstraction.\nThe pair of `From` impls provide bidirectional support for `?`\nconversion between `Report` and `anyhow::Error`.\n\n```\nuse std::error::Error as StdError;\n\npub struct Report {/* ... */}\n\nimpl<E> From<E> for Report\nwhere\nE: Into<anyhow::Error>,\nResult<(), E>: anyhow::Context<(), E>,\n{\nfn from(error: E) -> Self {\nlet anyhow_error: anyhow::Error = error.into();\nlet boxed_error: Box<dyn StdError + Send + Sync + 'static> = anyhow_error.into();\nReport::from_boxed(boxed_error)\n}\n}\n\nimpl From<Report> for anyhow::Error {\nfn from(report: Report) -> Self {\nlet boxed_error: Box<dyn StdError + Send + Sync + 'static> = report.into_boxed();\nanyhow::Error::from_boxed(boxed_error)\n}\n}\n\nimpl Report {\nfn from_boxed(boxed_error: Box<dyn StdError + Send + Sync + 'static>) -> Self {\ntodo!()\n}\nfn into_boxed(self) -> Box<dyn StdError + Send + Sync + 'static> {\ntodo!()\n}\n}\n\n// Example usage: can use `?` in both directions.\nfn a() -> anyhow::Result<()> {\nb()?;\nOk(())\n}\nfn b() -> Result<(), Report> {\na()?;\nOk(())\n}\n```","end_line":147,"is_exported":true,"modifiers":[],"name":"from_boxed","name_start_col":11,"name_start_line":144,"param_types":["Box<dyn StdError + Send + Sync + 'static>"],"path":"src/error.rs","positional_params":["boxed_error"],"return_type":"Self","start_col":4,"start_line":144}
N	Method	"anyhow.src.error.Error.is"	{"absolute_path":"<root>/src/error.rs","anchor_hash":"ah1:31583741f8e14cdd72fc12c5762ddaf05db826e1b3e15ced205980a25749f538","ast_branch_fingerprints":["b6b5aaa6d08798cf"],"ast_fingerprint":"da4af2b969531b97","ast_fingerprint_nodes":16,"decorators":[],"docstring":"Returns true if `E` is the type held by this error object.\n\nFor errors with context, this method returns true if `E` matches the\ntype of the context `C` **or** the type of the error on which the\ncontext has been attached. For details about the interaction between\ncontext and downcasting, [see here].\n\n[see here]: trait.Context.html#effect-on-downcasting","end_line":498,"is_exported":true,"modifiers":[],"name":"is","name_start_col":11,"name_start_line":493,"param_types":[""],"path":"src/error.rs","positional_params":["self"],"return_type":"bool","start_col":4,"start_line":493}
N	Method	"anyhow.src.error.Error.msg"	{"absolute_path":"<root>/src/error.rs","anchor_hash":"ah1:cad6ddce4e582b330cc4e53b15cb384c43f41ba4d81571e75bae475e3a562a51","ast_branch_fingerprints":["e7d603199ffee8b4"],"ast_fingerprint":"7392f98d9c50494a","ast_fingerprint_nodes":9,"decorated_start_line":79,"decorators":[],"docstring":"Create a new error object from a printable error message.\n\nIf the argument implements std::error::Error, prefer `Error::new`\ninstead which preserves the underlying error's cause chain and\nbacktrace. If the argument may or may not implement std::error::Error\nnow or in the future, use `anyhow!(err)` which handles either way\ncorrectly.\n\n`Error::msg(\"...\")` is equivalent to `anyhow!(\"...\")` but occasionally\nconvenient in places where a function is preferable over a macro, such\nas iterator or stream combinators:\n\n```\n# mod ffi {\n#     pub struct Input;\n#     pub struct Output;\n#     pub async fn do_some_work(_: Input) -> Result<Output, &'static str> {\n#         unimplemented!()\n#     }\n# }\n#\n# use ffi::{Input, Output};\n#\nuse anyhow::{Error, Result};\nuse futures::stream::{Stream, StreamExt, TryStreamExt};\n\nasync fn demo<S>(stream: S) -> Result<Vec<Output>>\nwhere\nS: Stream<Item = Input>,\n{\nstream\n.then(ffi::do_some_work) // returns Result<Output, &str>\n.map_err(Error::msg)\n.try_collect()\n.await\n}\n```","end_line":86,"is_exported":true,"modifiers":[],"name":"msg","name_start_col":11,"name_start_line":81,"param_types":["M"],"path":"src/error.rs","positional_params":["message"],"return_type":"Self","start_col":4,"start_line":81}
N	Method	"anyhow.src.error.Error.new"	{"absolute_path":"<root>/src/error.rs","anchor_hash":"ah1:a423ba4128036cb13f9ca4b655d296a4220258926d0f77aca91d18a2bc05bba6","ast_branch_fingerprints":["2f29090d88681c14","5d68d6888ce1fd55"],"ast_fingerprint":"75f723c98d66fa30","ast_fingerprint_nodes":16,"decorated_start_line":31,"decorators":[],"docstring":"Create a new error object from any error type.\n\nThe error type must be threadsafe and `'static`, so that the `Error`\nwill be as well.\n\nIf the error type does not provide a backtrace, a backtrace will be\ncreated here to ensure that a backtrace exists.","end_line":40,"is_exported":true,"modifiers":[],"name":"new","name_start_col":11,"name_start_line":34,"param_types":["E"],"path":"src/error.rs","positional_params":["error"],"return_type":"Self","start_col":4,"start_line":34}
