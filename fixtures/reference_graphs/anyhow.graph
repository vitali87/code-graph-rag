N	Function	"anyhow.src.macros.anyhow"	{"absolute_path":"<root>/src/macros.rs","anchor_hash":"ah1:8061e828ca8b0a8914c111e0f304cc7e1aad95d573b45d63eaf5825b70c6a21b","ast_branch_fingerprints":["06539222f25b46da","1984618db6e73279","1af488245ae9f2c9","25dc1027a8c69ab3","2a67aee0d775b83c","46bfa0fe5c662fda","553fcaf204abd0f5","7028d9b3d3425e15","72d69fd6b233ffbb","76810068fdc322a9","7d6aeb07fab487a9","840738906d542d39","88dbcc7fbb05daed","8ede1f1a8b12e880","8f863a8d37944060","a7ad303b92969db1","b65a105e4f075f58"],"ast_fingerprint":"0a78e574c57c2353","ast_fingerprint_nodes":111,"decorated_start_line":200,"decorators":["#[macro_export]"],"docstring":"Construct an ad-hoc error from a string or existing non-`anyhow` error\nvalue.\n\nThis evaluates to an [`Error`][crate::Error]. It can take either just a\nstring, or a format string with arguments. It also can take any custom type\nwhich implements `Debug` and `Display`.\n\nIf called with a single argument whose type implements `std::error::Error`\n(in addition to `Debug` and `Display`, which are always required), then that\nError impl's `source` is preserved as the `source` of the resulting\n`anyhow::Error`.\n\n# Example\n\n```\n# type V = ();\n#\nuse anyhow::{anyhow, Result};\n\nfn lookup(key: &str) -> Result<V> {\nif key.len() != 16 {\nreturn Err(anyhow!(\"key length must be 16 characters, got {:?}\", key));\n}\n\n// ...\n# Ok(())\n}\n```","end_line":220,"is_exported":true,"is_macro":true,"modifiers":["macro_rules!","let","use","match"],"name":"anyhow","name_start_col":13,"name_start_line":201,"path":"src/macros.rs","rust_visibility":"self","start_col":0,"start_line":201}
N	Function	"anyhow.src.macros.bail"	{"absolute_path":"<root>/src/macros.rs","anchor_hash":"ah1:979847c03bd47695b0288c89ee037af002be9eee56021426bc77994392381878","ast_branch_fingerprints":["33e01da4c6d89d73","450bf9fbaf6d4b9c","46bfa0fe5c662fda","553fcaf204abd0f5","7028d9b3d3425e15","7123a23b8d6a8aff","79fc067dbf31b8e7","840738906d542d39","8d5a2e27f042124e","ae387a5a7db96319","b4dbe23b55e32176"],"ast_fingerprint":"caea474c7bc789b0","ast_fingerprint_nodes":80,"decorated_start_line":56,"decorators":["#[macro_export]"],"docstring":"Return early with an error.\n\nThis macro is equivalent to\n<code>return Err([anyhow!($args\\...)][anyhow!])</code>.\n\nThe surrounding function's or closure's return value is required to be\n<code>Result&lt;_, [anyhow::Error][crate::Error]&gt;</code>.\n\n[anyhow!]: crate::anyhow\n\n# Example\n\n```\n# use anyhow::{bail, Result};\n#\n# fn has_permission(user: usize, resource: usize) -> bool {\n#     true\n# }\n#\n# fn main() -> Result<()> {\n#     let user = 0;\n#     let resource = 0;\n#\nif !has_permission(user, resource) {\nbail!(\"permission denied for accessing {}\", resource);\n}\n#     Ok(())\n# }\n```\n\n```\n# use anyhow::{bail, Result};\n# use thiserror::Error;\n#\n# const MAX_DEPTH: usize = 1;\n#\n#[derive(Error, Debug)]\nenum ScienceError {\n#[error(\"recursion limit exceeded\")]\nRecursionLimitExceeded,\n# #[error(\"...\")]\n# More = (stringify! {\n...\n# }, 1).1,\n}\n\n# fn main() -> Result<()> {\n#     let depth = 0;\n#\nif depth > MAX_DEPTH {\nbail!(ScienceError::RecursionLimitExceeded);\n}\n#     Ok(())\n# }\n```","end_line":67,"is_exported":true,"is_macro":true,"modifiers":["macro_rules!"],"name":"bail","name_start_col":13,"name_start_line":57,"path":"src/macros.rs","rust_visibility":"self","start_col":0,"start_line":57}
