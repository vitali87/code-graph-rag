N	Class	"afero.basepath.BasePathFile"	{"absolute_path":"<root>/basepath.go","anchor_hash":"ah1:d32a9e497fd16cffc9bcc786f0d22253d57400809de6f8794bce831428972b0e","decorators":[],"end_line":33,"field_types":["path\tstring"],"is_exported":true,"modifiers":[],"name":"BasePathFile","path":"basepath.go","start_col":5,"start_line":30}
N	Class	"afero.basepath.BasePathFs"	{"absolute_path":"<root>/basepath.go","anchor_hash":"ah1:f0ad053ba4f091215f73ac4fe58bba7cb9f7e15998fe29e1731e0e0c13d91f02","decorators":[],"docstring":"The BasePathFs restricts all operations to a given path within an Fs.\nThe given file name to the operations on this Fs will be prepended with\nthe base path before calling the base Fs.\nAny file name (after filepath.Clean()) outside this base path will be\ntreated as non existing file.\n\nNote that it does not clean the error messages on return, so you may\nreveal the real path on errors.","end_line":28,"field_types":["path\tstring","source\tFs"],"is_exported":true,"modifiers":[],"name":"BasePathFs","path":"basepath.go","start_col":5,"start_line":25}
N	Class	"afero.basepath_test.dirSpec"	{"absolute_path":"<root>/basepath_test.go","anchor_hash":"ah1:99b1e45ead15e31427720eddf19145783f8a47de8edf560b67fd39e76200072e","decorators":[],"end_line":94,"field_types":["Dir1\tstring","Dir2\tstring","Dir3\tstring"],"is_exported":false,"modifiers":[],"name":"dirSpec","path":"basepath_test.go","start_col":6,"start_line":92}
N	Class	"afero.basepath_test.spec"	{"absolute_path":"<root>/basepath_test.go","anchor_hash":"ah1:e0dfb2d487ea344129ab54dd71888e90f4e614a47402a9785afe87124690d4a8","decorators":[],"end_line":111,"field_types":["BaseFs\tFs","FileName\tstring"],"is_exported":false,"modifiers":[],"name":"spec","path":"basepath_test.go","start_col":7,"start_line":108}
N	Class	"afero.cacheOnReadFs.CacheOnReadFs"	{"absolute_path":"<root>/cacheOnReadFs.go","anchor_hash":"ah1:411988b0e12bd63badf6b0f1dd75ec692fc57a6751af1d15cad578dc2e0efa14","decorators":[],"docstring":"If the cache duration is 0, cache time will be unlimited, i.e. once\na file is in the layer, the base will never be read again for this file.\n\nFor cache times greater than 0, the modification time of a file is\nchecked. Note that a lot of file system implementations only allow a\nresolution of a second for timestamps... or as the godoc for os.Chtimes()\nstates: \"The underlying filesystem may truncate or round the values to a\nless precise time unit.\"\n\nThis caching union will forward all write calls also to the base file\nsystem first. To prevent writing to the base Fs, wrap it in a read-only\nfilter - Note: this will also make the overlay read-only, for writing files\nin the overlay, use the overlay Fs directly, not via the union Fs.","end_line":26,"field_types":["base\tFs","cacheTime\tDuration","layer\tFs"],"is_exported":true,"modifiers":[],"name":"CacheOnReadFs","path":"cacheOnReadFs.go","start_col":5,"start_line":22}
N	Class	"afero.composite_test.ev"	{"absolute_path":"<root>/composite_test.go","anchor_hash":"ah1:d0cc7d14051e32438937d333b9bc851e4a26ffa03f095e6a0cd30d675b8a09c9","decorators":[],"end_line":30,"field_types":["e\terror","path\tstring"],"is_exported":false,"modifiers":[],"name":"ev","path":"composite_test.go","start_col":6,"start_line":27}
N	Class	"afero.copyOnWriteFs.CopyOnWriteFs"	{"absolute_path":"<root>/copyOnWriteFs.go","anchor_hash":"ah1:2a80b3efdbbe359064a88f8bab27251563737f082f4cca64f1c118826edd39fe","decorators":[],"docstring":"The CopyOnWriteFs is a union filesystem: a read only base file system with\na possibly writeable layer on top. Changes to the file system will only\nbe made in the overlay: Changing an existing file in the base layer which\nis not present in the overlay will copy the file to the overlay (\"changing\"\nincludes also calls to e.g. Chtimes(), Chmod() and Chown()).\n\nReading directories is currently only supported via Open(), not OpenFile().","end_line":23,"field_types":["base\tFs","layer\tFs"],"is_exported":true,"modifiers":[],"name":"CopyOnWriteFs","path":"copyOnWriteFs.go","start_col":5,"start_line":20}
N	Class	"afero.gcsfs.file.GcsFile"	{"absolute_path":"<root>/gcsfs/file.go","anchor_hash":"ah1:671bb56c9aa57b5caf0ddc212db59fca9d1eb7e4c0c97dd9219c4e34dbe0c9d8","decorators":[],"docstring":"GcsFs is the Afero version adapted for GCS","end_line":42,"field_types":["ReadDirIt\tObjectIterator","closed\tbool","fhOffset\tint64","openFlags\tint","resource\tgcsFileResource"],"is_exported":true,"modifiers":[],"name":"GcsFile","path":"gcsfs/file.go","start_col":5,"start_line":36}
