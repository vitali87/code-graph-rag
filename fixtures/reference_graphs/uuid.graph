N	Function	"uuid.uuid.DisableRandPool"	{"absolute_path":"<root>/uuid.go","anchor_hash":"ah1:637633370230a0c0256da26b7d0905c6760b2b85a202c2ec0c280afe2616abfa","ast_branch_fingerprints":["02d0f699f4b08f1e","2e44b42e7cef6da2","49fef6c6bf14ba4c","7c840a7ebb366953","85a8e5fdd7582c25"],"ast_fingerprint":"cc78a82f40152c25","ast_fingerprint_nodes":27,"decorators":[],"docstring":"DisableRandPool disables the randomness pool if it was previously\nenabled with EnableRandPool.\n\nBoth EnableRandPool and DisableRandPool are not thread-safe and should\nonly be called when there is no possibility that New or any other\nUUID Version 4 generation function will be called concurrently.","end_line":353,"is_exported":true,"modifiers":["func"],"name":"DisableRandPool","name_start_col":5,"name_start_line":348,"param_types":[],"path":"uuid.go","positional_params":[],"start_col":0,"start_line":348}
N	Function	"uuid.uuid.EnableRandPool"	{"absolute_path":"<root>/uuid.go","anchor_hash":"ah1:7a2dad05d9eb96b11ad1bff340b95209b72b1d257ff3d8d5927f83988a1317d5","ast_branch_fingerprints":["49fef6c6bf14ba4c","c06434b8308e72a3"],"ast_fingerprint":"253304c5211b7933","ast_fingerprint_nodes":8,"decorators":[],"docstring":"EnableRandPool enables internal randomness pool used for Random\n(Version 4) UUID generation. The pool contains random bytes read from\nthe random number generator on demand in batches. Enabling the pool\nmay improve the UUID generation throughput significantly.\n\nSince the pool is stored on the Go heap, this feature may be a bad fit\nfor security sensitive applications.\n\nBoth EnableRandPool and DisableRandPool are not thread-safe and should\nonly be called when there is no possibility that New or any other\nUUID Version 4 generation function will be called concurrently.","end_line":340,"is_exported":true,"modifiers":["func"],"name":"EnableRandPool","name_start_col":5,"name_start_line":338,"param_types":[],"path":"uuid.go","positional_params":[],"start_col":0,"start_line":338}
