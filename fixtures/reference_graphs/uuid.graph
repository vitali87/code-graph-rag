N	Function	"uuid.version1.NewUUID"	{"absolute_path":"<root>/version1.go","anchor_hash":"ah1:65ba961a71bcaff2a74b86036c3098f8a2574976081bddc35a11ae7e73640365","ast_branch_fingerprints":["14c056da558f2aac","2e44b42e7cef6da2","36d220670c05a825","59bbf128abefb571","5a51552aa083109e","66bd5734b432268c","6764ec46bb6f6880","6f0962c430ca5359","6ff76af317ceb3b9","83822d8062ed7242","935891080aad67a2","a5248ab24f9768df","adcabd02867ab8cc","bc43cd27393c2662","c3151d1bff229db7","d973ad6e447bc280"],"ast_fingerprint":"5c5e05b03c7dcc7e","ast_fingerprint_nodes":167,"decorators":[],"docstring":"NewUUID returns a Version 1 UUID based on the current NodeID and clock\nsequence, and the current time.  If the NodeID has not been set by SetNodeID\nor SetNodeInterface then it will be set automatically.  If the NodeID cannot\nbe set NewUUID returns nil.  If clock sequence has not been set by\nSetClockSequence then it will be set automatically.  If GetTime fails to\nreturn the current NewUUID returns nil and an error.\n\nIn most cases, New should be used.","end_line":44,"first_return_type":"UUID","is_exported":true,"modifiers":["func"],"name":"NewUUID","name_start_col":5,"name_start_line":19,"param_types":[],"path":"version1.go","positional_params":[],"return_type":"(UUID, error)","start_col":0,"start_line":19}
N	Function	"uuid.version4.New"	{"absolute_path":"<root>/version4.go","anchor_hash":"ah1:f5ea9c679c2f43feae3a45d24dc7b766b905051c3ae1ac796c4625ae99d14022","ast_branch_fingerprints":["c25e7236d864126a","f4c9bf1acbdca622"],"ast_fingerprint":"b710c5b182bdb5f3","ast_fingerprint_nodes":11,"chain_return_type":"UUID","decorators":[],"docstring":"New creates a new random UUID or panics.  New is equivalent to\nthe expression\n\nuuid.Must(uuid.NewRandom())","end_line":15,"first_return_type":"UUID","is_exported":true,"modifiers":["func"],"name":"New","name_start_col":5,"name_start_line":13,"param_types":[],"path":"version4.go","positional_params":[],"return_type":"UUID","start_col":0,"start_line":13}
N	Function	"uuid.version4.NewRandom"	{"absolute_path":"<root>/version4.go","anchor_hash":"ah1:6b5c2a3e04f77171b6305d2af45d70171628ca32cf01c0689d191f4b2908d9a2","ast_branch_fingerprints":["2eddf85bd76a3fe9","3955ad2fab831b0e","8274a15ffc4489c2","9cdda470f44e1bbf","d807fd2eb66666cc"],"ast_fingerprint":"5541e9c67783a08f","ast_fingerprint_nodes":22,"decorators":[],"docstring":"NewRandom returns a Random (Version 4) UUID.\n\nThe strength of the UUIDs is based on the strength of the crypto/rand\npackage.\n\nUses the randomness pool if it was enabled with EnableRandPool.\n\nA note about uniqueness derived from the UUID Wikipedia entry:\n\nRandomly generated UUIDs have 122 random bits.  One's annual risk of being\nhit by a meteorite is estimated to be one chance in 17 billion, that\nmeans the probability is about 0.00000000006 (6 × 10−11),\nequivalent to the odds of creating a few tens of trillions of UUIDs in a\nyear and having one duplicate.","end_line":44,"first_return_type":"UUID","is_exported":true,"modifiers":["func"],"name":"NewRandom","name_start_col":5,"name_start_line":39,"param_types":[],"path":"version4.go","positional_params":[],"return_type":"(UUID, error)","start_col":0,"start_line":39}
N	Function	"uuid.version4.NewRandomFromReader"	{"absolute_path":"<root>/version4.go","anchor_hash":"ah1:b85e3f25090a9a9f13b0ced794969a6f83e2845bffdd2cc460675e0df5c83947","ast_branch_fingerprints":["00cad182967f4135","14c056da558f2aac","36d220670c05a825","5a51552aa083109e","6764ec46bb6f6880","79874305bd7a970d","935891080aad67a2","ff4693de3ff5bb5a"],"ast_fingerprint":"5ef3a72cfa00ce91","ast_fingerprint_nodes":73,"decorators":[],"docstring":"NewRandomFromReader returns a UUID based on bytes read from a given io.Reader.","end_line":56,"first_return_type":"UUID","is_exported":true,"modifiers":["func"],"name":"NewRandomFromReader","name_start_col":5,"name_start_line":47,"param_types":["io.Reader"],"path":"version4.go","positional_params":["r"],"return_type":"(UUID, error)","start_col":0,"start_line":47}
N	Function	"uuid.version4.NewString"	{"absolute_path":"<root>/version4.go","anchor_hash":"ah1:2fe5be9b2ffb1d86e3643ddc37250a10dc997d8968a528cb1242e43875d0a12e","ast_branch_fingerprints":["33f198bae80f5b69","389bc74cbaea2376"],"ast_fingerprint":"90400b76ed04d1e2","ast_fingerprint_nodes":15,"chain_return_type":"string","decorators":[],"docstring":"NewString creates a new random UUID and returns it as a string or panics.\nNewString is equivalent to the expression\n\nuuid.New().String()","end_line":23,"first_return_type":"string","is_exported":true,"modifiers":["func"],"name":"NewString","name_start_col":5,"name_start_line":21,"param_types":[],"path":"version4.go","positional_params":[],"return_type":"string","start_col":0,"start_line":21}
N	Function	"uuid.version4.newRandomFromPool"	{"absolute_path":"<root>/version4.go","anchor_hash":"ah1:dd5ce705cf45d53dc1cf0783729e7002e109b176d23b10374870bb44586d58d7","ast_branch_fingerprints":["00cad182967f4135","0af9225997d13966","14c056da558f2aac","2e44b42e7cef6da2","49fef6c6bf14ba4c","5a51552aa083109e","656573cd7e7df22f","6fd83b2c8296a868","935891080aad67a2","9d568266774e37eb","a1c2b97d85d774a3","d0ef164e77e5cff3","e7507c8ab778a3a4","ff4693de3ff5bb5a"],"ast_fingerprint":"7f5df7aec90922b2","ast_fingerprint_nodes":125,"decorators":[],"end_line":76,"first_return_type":"UUID","is_exported":false,"modifiers":["func"],"name":"newRandomFromPool","name_start_col":5,"name_start_line":58,"param_types":[],"path":"version4.go","positional_params":[],"return_type":"(UUID, error)","start_col":0,"start_line":58}
N	Function	"uuid.version6.NewV6"	{"absolute_path":"<root>/version6.go","anchor_hash":"ah1:dcbc76fe9021daaa2808bc902f2e419689ffc1436c4d7304d8f41770e246e513","ast_branch_fingerprints":["14c056da558f2aac","2e44b42e7cef6da2","36d220670c05a825","59bbf128abefb571","5a51552aa083109e","66bd5734b432268c","6764ec46bb6f6880","6f0962c430ca5359","935891080aad67a2","a5248ab24f9768df","bc43cd27393c2662","d5f2349ebe015f66","d973ad6e447bc280","fa1a687a75f42205","fca2795d15615784"],"ast_fingerprint":"ad51a9497ecac6b7","ast_fingerprint_nodes":130,"decorators":[],"docstring":"UUID version 6 is a field-compatible version of UUIDv1, reordered for improved DB locality.\nIt is expected that UUIDv6 will primarily be used in contexts where there are existing v1 UUIDs.\nSystems that do not involve legacy UUIDv1 SHOULD consider using UUIDv7 instead.\n\nsee https://datatracker.ietf.org/doc/html/draft-peabody-dispatch-new-uuid-format-03#uuidv6\n\nNewV6 returns a Version 6 UUID based on the current NodeID and clock\nsequence, and the current time. If the NodeID has not been set by SetNodeID\nor SetNodeInterface then it will be set automatically. If the NodeID cannot\nbe set NewV6 set NodeID is random bits automatically . If clock sequence has not been set by\nSetClockSequence then it will be set automatically. If GetTime fails to\nreturn the current NewV6 returns Nil and an error.","end_line":56,"first_return_type":"UUID","is_exported":true,"modifiers":["func"],"name":"NewV6","name_start_col":5,"name_start_line":21,"param_types":[],"path":"version6.go","positional_params":[],"return_type":"(UUID, error)","start_col":0,"start_line":21}
N	Function	"uuid.version7.NewV7"	{"absolute_path":"<root>/version7.go","anchor_hash":"ah1:7f9a5951c4d151736efc446cdbc96016964a6c43041a481df7e59792416731c9","ast_branch_fingerprints":["0d6cc64630321b0d","14c056da558f2aac","36d220670c05a825","55f26732274f7ba3","5a51552aa083109e","6764ec46bb6f6880","eaf975f4f86f957c"],"ast_fingerprint":"50bb38fb968a0610","ast_fingerprint_nodes":35,"decorators":[],"docstring":"UUID version 7 features a time-ordered value field derived from the widely\nimplemented and well known Unix Epoch timestamp source,\nthe number of milliseconds seconds since midnight 1 Jan 1970 UTC, leap seconds excluded.\nAs well as improved entropy characteristics over versions 1 or 6.\n\nsee https://datatracker.ietf.org/doc/html/draft-peabody-dispatch-new-uuid-format-03#name-uuid-version-7\n\nImplementations SHOULD utilize UUID version 7 over UUID version 1 and 6 if possible.\n\nNewV7 returns a Version 7 UUID based on the current time(Unix Epoch).\nUses the randomness pool if it was enabled with EnableRandPool.\nOn error, NewV7 returns Nil and an error","end_line":30,"first_return_type":"UUID","is_exported":true,"modifiers":["func"],"name":"NewV7","name_start_col":5,"name_start_line":23,"param_types":[],"path":"version7.go","positional_params":[],"return_type":"(UUID, error)","start_col":0,"start_line":23}
N	Function	"uuid.version7.NewV7FromReader"	{"absolute_path":"<root>/version7.go","anchor_hash":"ah1:3c49cfa54c660e90abf910a4b75d17d4ff987afcd08becc6eb06635b300b5852","ast_branch_fingerprints":["0d6cc64630321b0d","14c056da558f2aac","36d220670c05a825","4a244fe771cd0369","5a51552aa083109e","6764ec46bb6f6880","d31144beb781d1b8"],"ast_fingerprint":"2ca376701f120241","ast_fingerprint_nodes":36,"decorators":[],"docstring":"NewV7FromReader returns a Version 7 UUID based on the current time(Unix Epoch).\nit use NewRandomFromReader fill random bits.\nOn error, NewV7FromReader returns Nil and an error.","end_line":43,"first_return_type":"UUID","is_exported":true,"modifiers":["func"],"name":"NewV7FromReader","name_start_col":5,"name_start_line":35,"param_types":["io.Reader"],"path":"version7.go","positional_params":["r"],"return_type":"(UUID, error)","start_col":0,"start_line":35}
