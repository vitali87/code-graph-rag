N	Method	"javapoet.src.main.java.com.squareup.javapoet.TypeSpec.TypeSpec.Builder.avoidClashesWithNestedClasses(Class<?>)"	{"absolute_path":"<root>/src/main/java/com/squareup/javapoet/TypeSpec.java","anchor_hash":"ah1:d613104e3403826eb854e0aaa39d8a8603c7d5937e0920cfbc0764288a6f802c","ast_branch_fingerprints":["4623e3fea4688384","59a7e630978d8cfe","63c1ff632875b0dd","90c43667ead2cf5b","a48059336138abb6","cf3746ad4e4f3de1","dde9a65121f41f04"],"ast_fingerprint":"6a45e1d2b0b6327a","ast_fingerprint_nodes":93,"decorators":[],"docstring":"Call this to always fully qualify any types that would conflict with possibly nested types of\nthis {@code typeElement}. For example - if the following type was passed in as the\ntypeElement:\n\n<pre><code>\n  class Foo {\n    class NestedTypeA {\n\n    }\n    class NestedTypeB {\n\n    }\n  }\n</code></pre>\n\n<p>\nThen this would add {@code \"NestedTypeA\"} and {@code \"NestedTypeB\"} as names that should\nalways be qualified via {@link #alwaysQualify(String...)}. This way they would avoid\npossible import conflicts when this JavaFile is written.\n\n@param clazz the {@link Class} with nested types to avoid clashes with.\n@return this builder instance.","end_line":752,"is_exported":true,"modifiers":["public"],"name":"avoidClashesWithNestedClasses","name_start_col":19,"name_start_line":739,"param_types":["Class<?>"],"path":"src/main/java/com/squareup/javapoet/TypeSpec.java","positional_params":["clazz"],"return_type":"Builder","start_col":4,"start_line":739}
N	Method	"javapoet.src.main.java.com.squareup.javapoet.TypeSpec.TypeSpec.Builder.avoidClashesWithNestedClasses(TypeElement)"	{"absolute_path":"<root>/src/main/java/com/squareup/javapoet/TypeSpec.java","anchor_hash":"ah1:42a75b027ff91918dfe8cc540e1658a869d9b99833c7202231d98db6a6c967ee","ast_branch_fingerprints":["0db6cbdce7899c9c","25efe86be9a7527c","59ea090616bc8c1d","60b35ea8d63f31b9","65ec58bfa8bc6b1d","90c43667ead2cf5b","9d7776b769fad947","a48059336138abb6","a619534c94de388f"],"ast_fingerprint":"671bfbee6e882a86","ast_fingerprint_nodes":118,"decorators":[],"docstring":"Call this to always fully qualify any types that would conflict with possibly nested types of\nthis {@code typeElement}. For example - if the following type was passed in as the\ntypeElement:\n\n<pre><code>\n  class Foo {\n    class NestedTypeA {\n\n    }\n    class NestedTypeB {\n\n    }\n  }\n</code></pre>\n\n<p>\nThen this would add {@code \"NestedTypeA\"} and {@code \"NestedTypeB\"} as names that should\nalways be qualified via {@link #alwaysQualify(String...)}. This way they would avoid\npossible import conflicts when this JavaFile is written.\n\n@param typeElement the {@link TypeElement} with nested types to avoid clashes with.\n@return this builder instance.","end_line":713,"is_exported":true,"modifiers":["public"],"name":"avoidClashesWithNestedClasses","name_start_col":19,"name_start_line":695,"param_types":["TypeElement"],"path":"src/main/java/com/squareup/javapoet/TypeSpec.java","positional_params":["typeElement"],"return_type":"Builder","start_col":4,"start_line":695}
