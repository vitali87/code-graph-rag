# Settings for one runner-pool server. install.sh copies this file to
# /etc/runner-pool/pool.env (readable by root only) the first time it runs;
# fill that copy in and run install.sh again. Re-run it after any change.

# A fine-grained personal access token, limited to the repositories below,
# with two repository permissions:
#   Administration: Read and write  - to add and remove this server's runners
#   Variables: Read and write       - to tell CI whether the pool has room
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# The repositories this server takes jobs for, separated by spaces. Slots
# are dealt out over the list in turn, so naming a repository twice gives it
# twice the share.
REPOS="vitali87/code-graph-rag vitali87/croft"

# How many jobs this server runs at once. "auto" allows one per 2 CPU cores
# and 4 GB of memory.
SLOTS=auto

# Run the switch that tells CI whether the pool has a free slot. Leave it on
# on every server: each copy reaches the same answer, and CI keeps getting it
# for as long as any server is up.
RUN_SWITCH=yes

# Optional: a Docker Hub account for this server's image cache. Without one
# Docker Hub allows only a limited number of downloads per address per hour.
# Use an access token, not the password.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
